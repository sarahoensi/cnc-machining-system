{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "cnc-machining-system",
  "version": "0.3.0",
  "identifier": "com.sarahoensi.cnc-machining-system",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CutPilot",
        "width": 900,
        "height": 730,
        "minWidth": 400,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": ["data/iso286.sqlite", "data/threads.sqlite"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
